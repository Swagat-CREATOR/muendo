{
  "name": "mewndo",
  "version": "0.1.0",
  "description": "Undo what AI agents did to your files.",
  "private": true,
  "main": "app/main.js",
  "bin": {
    "mewndo-savepoint": "bin/mewndo-savepoint.js"
  },
  "scripts": {
    "start": "electron .",
    "test": "node --test \"test/**/*.test.js\"",
    "reliability": "node scripts/reliability.js",
    "responsiveness": "node scripts/responsiveness.js",
    "bench": "node scripts/bench.js",
    "dist": "node build/stage-binaries.js && electron-builder --win --x64",
    "dist:check": "node build/stage-binaries.js --check"
  },
  "engines": {
    "node": ">=22"
  },
  "dependencies": {
    "chokidar": "^4.0.3",
    "koffi": "^2.14.1"
  },
  "devDependencies": {
    "electron": "44.5.1",
    "electron-builder": "^26.15.3"
  },
  "build": {
    "appId": "com.mewndo.app",
    "productName": "Mewndo",
    "directories": {
      "output": "dist"
    },
    "files": [
      "app/**",
      "engine/**",
      "bin/**",
      "package.json"
    ],
    "extraResources": [
      {
        "from": "../../core/target/release/mewndo-core.exe",
        "to": "mewndo-core.exe"
      },
      {
        "from": "../../core/target/release/mewndo-hook.exe",
        "to": "mewndo-hook.exe"
      },
      {
        "from": "../../integrations/claude-code",
        "to": "claude-code"
      }
    ],
    "asarUnpack": [
      "bin/**"
    ],
    "publish": null,
    "forceCodeSigning": false,
    "win": {
      "target": "nsis",
      "icon": "build/icon.ico"
    },
    "nsis": {
      "oneClick": true,
      "perMachine": false,
      "createStartMenuShortcut": true,
      "createDesktopShortcut": false,
      "shortcutName": "Mewndo",
      "uninstallDisplayName": "Mewndo",
      "include": "build/installer.nsh"
    }
  }
}
